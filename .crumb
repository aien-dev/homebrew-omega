  "name": "homebrew-omega",
  "parent": "aien-dev/omega-mv@e5b32567a7aff3ce594e3254a622a846a6cd190b",
  "purpose": "Homebrew tap (aien-dev/omega) whose Formula/omc.rb births omc from omega-mv's 408-byte seed at the pinned commit with seed/omega-from-seed.sh and refuses any omc whose sha256 differs from the pinned value; Linux arm64 only.",
  "layer": "distribution",
  "invariants": [
    "The formula never downloads a prebuilt omc; it builds from the seed and checks the pinned sha256.",
    "Pins match aien-dev/omega-packages pins.env.",
    "The control job must fail to install a formula with a wrong pinned hash; a passing control is a broken workflow."
  ]
}
